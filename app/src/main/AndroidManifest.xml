<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Only used when you choose a profile photo from Downloads, Pictures or USB. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- For the "Close apps" button: stops other apps' background processes. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Lets the launcher see every TV app on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="Lumen"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Exported so a profile photo can be set over adb (see README). -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="Lumen Settings"
            android:screenOrientation="landscape" />

        <activity
            android:name=".QuickSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="Quick Settings"
            android:launchMode="singleTask"
            android:taskAffinity="com.partha.lumen.quick"
            android:theme="@style/Lumen.Panel" />

        <!-- Remote buttons: watches key presses only (see res/xml/remote_service.xml). -->
        <service
            android:name=".RemoteService"
            android:exported="true"
            android:label="@string/remote_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_service" />
        </service>
    </application>
</manifest>
